{
  // Type-checks the test files, which the package builds exclude so they
  // never ship in dist/. Run after `tsc -b` so cross-package imports resolve.
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": ["packages/*/src/**/*.ts", "vitest.config.ts"]
}
