    "directory": "packages/core"
  },
  "homepage": "https://github.com/KRISH-V-0610/FluxGate#readme",
  "bugs": "https://github.com/KRISH-V-0610/FluxGate/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
