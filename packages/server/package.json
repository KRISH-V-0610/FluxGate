{
  "name": "@fluxgate/server",
  "version": "1.0.0",
  "description": "The deployable FluxGate server: a demo API, the rate-limit service (POST /v1/check) and Prometheus /metrics, configured from environment variables.",
  "license": "MIT",
  "author": "Krish Vaghasia",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
