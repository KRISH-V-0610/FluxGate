      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@fluxgate/core": "1.0.0",
    "@fluxgate/http": "1.0.0",
    "@fluxgate/redis": "1.0.0",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@fluxgate/client": "1.0.0",
    "@types/express": "^5.0.6"
  }
}
