{
  "name": "@fluxgate/client",
  "version": "1.0.0",
  "description": "Client for the FluxGate rate-limit service: one HTTP call per decision, from any app or edge runtime. Plugs into every @fluxgate/http adapter. No runtime dependencies besides @fluxgate/core types.",
  "keywords": [
    "rate-limiter",
    "rate-limiting",
    "client",
    "edge",
    "service"
  ],
  "license": "MIT",
  "author": "Krish Vaghasia",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KRISH-V-0610/FluxGate.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/KRISH-V-0610/FluxGate#readme",
  "bugs": "https://github.com/KRISH-V-0610/FluxGate/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "prepublishOnly": "tsc -b"
  },
  "dependencies": {
    "@fluxgate/core": "1.0.0"
  },
  "engines": {
    "node": ">=20"
  }
}
