{
  "name": "@fluxgate/http",
  "version": "1.0.0",
  "description": "Rate limiting for any HTTP stack: a framework-agnostic check(), adapters for Express, Fastify, Hono and the Fetch API (Next.js, Bun, Deno, Cloudflare Workers), and Prometheus metrics. No runtime dependencies besides @fluxgate/core.",
  "keywords": [
    "rate-limiter",
    "rate-limiting",
    "express",
    "fastify",
    "hono",
    "nextjs",
    "middleware",
    "prometheus"
  ],
  "license": "MIT",
  "author": "Krish Vaghasia",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "default": "./dist/express.js"
    },
    "./fastify": {
      "types": "./dist/fastify.d.ts",
      "default": "./dist/fastify.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "default": "./dist/hono.js"
    },
    "./fetch": {
      "types": "./dist/fetch.d.ts",
      "default": "./dist/fetch.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsc -b",
    "prepublishOnly": "tsc -b"
  },
  "dependencies": {
    "@fluxgate/core": "1.0.0"
  },
  "peerDependencies": {
    "express": ">=4",
    "fastify": ">=4",
    "hono": ">=4"
  },
  "peerDependenciesMeta": {
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "express": "^5.2.1",
    "fastify": "^5.12.5",
    "hono": "^4.13.13"
  }
}
